<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Vibracion: confirma que el registro quedo guardado sin mirar la pantalla (RNF-01).
         Se otorga al instalar, no se le pregunta al usuario. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Camara: la foto de perfil del colaborador (y la evidencia del evento). Es un permiso
         peligroso: se pide en pantalla la primera vez, diciendo para que se usa. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- La camara no es obligatoria para que la app sirva: no se exige en el catalogo de equipos -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Para avisar cuando no hay red: la app no pierde nada, todo queda en la base local (RNF-03) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RinconSur">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.RinconSur"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- La app de camara escribe la foto por nosotros: desde API 24 no puede recibir una URI
             file://, asi que se le entrega una del FileProvider. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.archivos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rutas_archivos" />
        </provider>
    </application>

</manifest>